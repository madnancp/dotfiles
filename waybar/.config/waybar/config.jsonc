{
    "layer": "top",
    "position": "top",
    "height": 20,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "network", "battery", "clock", "tray" ],
    "hyprland/workspaces": {
	"disable-scroll": true,
	"all-outputs": true,
	"on-click": "activate",
	"format": "{icon}",
    },
    "hyprland/window": {
	"format": "{}",
	"max-length": 50,
	"tooltip": true
    },
    "tray": {
	"icon-size": 21,
	"spacing": 10
    },
    "clock": {
	"format": "{:%a, %b %d  %H:%M}",
	"tooltip-format": "{:%Y-%m-%d %H:%M:%S}",
	"interval": 60
    },
    "network": {
	// "interface": "wlp2s0",
	"format-wifi": "{essid} ",
	"format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
	"format-disconnected": "Disconnected ⚠"
	"format-disabled": "󰖪",
    },
    "battery": {
	"bat": "BAT0",
	"states": {
	    "warning": 30,
	    "critical": 15
	},
	"format": "{capacity}% {icon}",
	"format-charging": "{capacity}%⚡",
	"format-alt": "{icon}",
	"format-icons": [ "󰁺", "󰁼", "󰁾", "󰂀", "󰁹" ]
    },
    "pulseaudio": {
	// "scroll-step": 1, // %, can be a float
	"format": "{icon} {volume}%",
	"format-muted": "",
	"format-icons": {
	    "default": ["", "", " "]
	},
	"on-click": "pavucontrol"
    },
}
